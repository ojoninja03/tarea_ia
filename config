# 1. PROBLEMA DE LAS N-REINAS
# ==========================================

INSTANCIAS_REINAS = [{'id': f'reinas_{n}', 'n': n} for n in (8, 50, 100)]

def calcular_conflictos_reinas(posiciones):
    """Calcula pares de reinas en conflicto en O(N)."""
    arr = np.asarray(posiciones, dtype=int)
    n = len(arr)
    if n == 0:
        return 0
    freq_col = np.bincount(arr, minlength=n)
    freq_d1 = np.bincount(np.arange(n) + arr, minlength=2*n)
    freq_d2 = np.bincount(np.arange(n) - arr + n - 1, minlength=2*n)

    def combinaciones(c):
        return int(np.sum(c * (c - 1) // 2))

    return combinaciones(freq_col) + combinaciones(freq_d1) + combinaciones(freq_d2)

def evaluador_reinas(instancia, solucion):
    n = instancia['n']
    if solucion is None:
        return {'factible': False, 'objetivo': np.nan, 'metricas': {'conflictos': None}}
    arr = np.asarray(solucion)
    if arr.shape != (n,) or not np.isin(arr, np.arange(n)).all():
        return {'factible': False, 'objetivo': np.nan, 'metricas': {'conflictos': None}}
    
    conf = calcular_conflictos_reinas(arr.astype(int))
    return {
        'factible': (conf == 0),
        'objetivo': float(conf),
        'metricas': {'conflictos': conf}
    }

def solver_bt_reinas(instancia, *, seed, presupuesto, parametros):
    n = instancia['n']
    rng = np.random.default_rng(seed)
    t_start = time.perf_counter()
    max_eval, max_sec = presupuesto['max_evaluaciones'], presupuesto['max_segundos']
    
    tablero = np.full(n, -1, dtype=int)
    cols_used = np.zeros(n, dtype=bool)
    diag_asc = np.zeros(2*n, dtype=bool)
    diag_desc = np.zeros(2*n, dtype=bool)
    evals, iters = 0, 0
    hist, stop_reason = [], 'busqueda_agotada'

    def limite_alcanzado():
        return evals >= max_eval or (time.perf_counter() - t_start) >= max_sec

    def backtrack(row):
        nonlocal evals, iters, stop_reason
        iters += 1
        if row == n:
            hist.append({'evaluaciones': evals, 'objetivo': 0.0})
            stop_reason = 'solucion_encontrada'
            return True
        if limite_alcanzado():
            stop_reason = 'presupuesto_agotado'
            return False

        opciones = []
        for c in range(n):
            if cols_used[c] or diag_asc[row - c + n - 1] or diag_desc[row + c]:
                continue
            # Heurística de impacto / restricción hacia adelante
            impacto = sum(1 for f in range(row + 1, n) if (c + (f - row) < n) or (c - (f - row) >= 0))
            opciones.append((impacto, rng.random(), c))

        opciones.sort()
        for _, _, c in opciones:
            if limite_alcanzado():
                stop_reason = 'presupuesto_agotado'
                return False
            evals += 1
            tablero[row] = c
            cols_used[c] = diag_asc[row - c + n - 1] = diag_desc[row + c] = True

            if backtrack(row + 1):
                return True

            tablero[row] = -1
            cols_used[c] = diag_asc[row - c + n - 1] = diag_desc[row + c] = False

        return False

    exito = backtrack(0)
    return {
        'solucion': tablero.tolist() if exito else None,
        'evaluaciones': evals,
        'iteraciones': iters,
        'motivo_parada': stop_reason,
        'historial': hist
    }

CATALOGO_EVALUADORES['reinas'] = evaluador_reinas
registrar_algoritmo('reinas', 'BT_MRV_Ordenado', 'BT', solver_bt_reinas)

