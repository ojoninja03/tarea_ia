# Registros globales
CATALOGO_SOLVERS = {}
CATALOGO_EVALUADORES = {}
CONFIGURACION_PARAMETROS = {}
HISTORIAL_RUNS = []
DETALLES_EJECUCION = {}


def registrar_algoritmo(problema_id, nombre_algoritmo, familia, funcion_solver, params=None):
    """Registra una variante algorítmica en el arnés experimental."""
    familias_validas = {'BT', 'LOCAL', 'EVOL', 'HIBRIDO'}
    if familia not in familias_validas:
        raise ValueError(f"Familia no válida: {familia}")
    if problema_id == 'eggholder' and familia == 'BT':
        raise ValueError("Backtracking no es aplicable al dominio continuo Eggholder.")
    
    key = (problema_id, nombre_algoritmo)
    CATALOGO_SOLVERS[key] = (familia, funcion_solver)
    CONFIGURACION_PARAMETROS[key] = copy.deepcopy(params or {})


def ejecutar_suite_experimentos(problema_id, lista_instancias, semillas=CONFIG_SEMILLAS, limites=None):
    """Ejecuta el protocolo experimental completo para un problema determinado."""
    limites_eje = dict(limites or PRESUPUESTO_EJECUCION)
    algoritmos = [(nombre, fam, fn) for (p, nombre), (fam, fn) in CATALOGO_SOLVERS.items() if p == problema_id]
    
    if not algoritmos or problema_id not in CATALOGO_EVALUADORES:
        print(f"[{problema_id}] No se encontraron solucionadores o evaluadores registrados.")
        return

    id_lote = uuid.uuid4().hex[:8]
    for inst in lista_instancias:
        for nombre_alg, fam, solver_fn in algoritmos:
            for s in semillas:
                run_id = uuid.uuid4().hex
                registro = {
                    'id': run_id,
                    'lote': id_lote,
                    'problema': problema_id,
                    'instancia': inst['id'],
                    'algoritmo': nombre_alg,
                    'familia': fam,
                    'semilla': s,
                    'parametros': json.dumps(CONFIGURACION_PARAMETROS[(problema_id, nombre_alg)], sort_keys=True),
                    'max_evaluaciones': limites_eje['max_evaluaciones'],
                    'max_segundos': limites_eje['max_segundos'],
                    'estado': 'error',
                    'factible': False,
                    'objetivo': np.nan,
                    'tiempo_s': np.nan,
                    'evaluaciones': np.nan,
                    'iteraciones': np.nan,
                    'excedio_presupuesto': False,
                    'motivo_parada': '',
                    'error': ''
                }
                
                t_inicio = None
                try:
                    inst_copia = copy.deepcopy(inst)
                    t_inicio = time.perf_counter()
                    res = solver_fn(
                        inst_copia,
                        seed=s,
                        presupuesto=dict(limites_eje),
                        parametros=copy.deepcopy(CONFIGURACION_PARAMETROS[(problema_id, nombre_alg)])
                    )
                    registro['tiempo_s'] = time.perf_counter() - t_inicio
                    
                    for k in ['evaluaciones', 'iteraciones']:
                        val = res[k]
                        if isinstance(val, (bool, np.bool_)) or not isinstance(val, (int, np.integer)) or val < 0:
                            raise ValueError(f"El campo {k} debe ser un entero no negativo.")
                        registro[k] = int(val)

                    eval_res = CATALOGO_EVALUADORES[problema_id](copy.deepcopy(inst), res['solucion'])
                    registro['factible'] = bool(eval_res['factible'])
                    obj_val = float(eval_res['objetivo'])
                    
                    if registro['factible'] and not np.isfinite(obj_val):
                        raise ValueError("Solución factible requiere valor objetivo finito.")

                    registro['objetivo'] = obj_val
                    registro['motivo_parada'] = str(res['motivo_parada'])
                    registro['estado'] = 'ok'
                    registro['excedio_presupuesto'] = (
                        registro['tiempo_s'] > limites_eje['max_segundos'] or 
                        registro['evaluaciones'] > limites_eje['max_evaluaciones']
                    )
                    
                    DETALLES_EJECUCION[run_id] = {'salida': res, 'evaluacion': eval_res}
                except Exception as ex:
                    if t_inicio is not None and not np.isfinite(registro['tiempo_s']):
                        registro['tiempo_s'] = time.perf_counter() - t_inicio
                    registro['error'] = f"{type(ex).__name__}: {ex}"

                HISTORIAL_RUNS.append(registro)
    print(f"Lote {id_lote} completado. Total acumulado de ejecuciones: {len(HISTORIAL_RUNS)}")


