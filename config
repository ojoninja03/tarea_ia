def generar_reporte_resumen(problema_id=None):
    df = pd.DataFrame(HISTORIAL_RUNS)
    if df.empty or problema_id is None:
        return df
    sub = df[df.problema == problema_id].copy()
    sub['valido'] = (sub.estado == 'ok') & sub.factible & ~sub.excedio_presupuesto
    sub['obj_valido'] = sub.objetivo.where(sub.valido)
    
    res = sub.groupby(['lote', 'instancia', 'algoritmo']).agg(
        corridas=('id', 'size'),
        tasa_factible=('valido', 'mean'),
        tiempo_mediana_s=('tiempo_s', 'median'),
        evaluaciones_mediana=('evaluaciones', 'median'),
        objetivo_mediana=('obj_valido', 'median'),
        objetivo_std=('obj_valido', 'std')
    ).reset_index()
    return res

