# Configuración global del entorno experimental
CONFIG_SEMILLAS = [11, 22, 33, 44, 55]
PRESUPUESTO_EJECUCION = {'max_evaluaciones': 10_000, 'max_segundos': 10.0}

ENTORNO_SISTEMA = {
    'python_version': platform.python_version(),
    'numpy_version': np.__version__,
